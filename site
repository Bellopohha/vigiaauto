              onClick={() => handleSendMessage("Qual o valor da mensalidade?")}
              className="bg-slate-900/80 hover:bg-slate-800 text-slate-300 px-2.5 py-1 rounded-full whitespace-nowrap"
            >
              💰 Valores e taxas
            </button>
            <button 
              onClick={() => handleSendMessage("Como funciona a instalação?")}
              className="bg-slate-900/80 hover:bg-slate-800 text-slate-300 px-2.5 py-1 rounded-full whitespace-nowrap"
            >
              🛠️ Instalação
            </button>
          </div>

          {/* Input Box */}
          <div className="p-3 bg-[#02050d] border-t border-slate-900 flex items-center gap-2">
            <input 
              type="text"
              value={inputMessage}
              onChange={(e) => setInputMessage(e.target.value)}
              onKeyDown={(e) => e.key === 'Enter' && handleSendMessage()}
              placeholder="Digite sua dúvida sobre rastreamento..."
              className="flex-1 bg-[#010206] border border-slate-800 focus:border-cyan-400 rounded-xl px-3 py-2 text-xs text-white placeholder-slate-500 focus:outline-none"
            />
            <button 
              onClick={() => handleSendMessage()}
              disabled={isChatThinking || !inputMessage.trim()}
              className="bg-blue-600 hover:bg-blue-500 disabled:opacity-50 text-white p-2 rounded-xl transition shrink-0"
            >
              <Send size={16} />
            </button>
          </div>
        </div>
      )}

      {/* Footer */}
      <footer className="bg-[#000002] py-12 border-t border-slate-950 text-slate-400 text-xs">
        <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col md:flex-row justify-between items-center gap-6">
          
          <div className="flex items-center space-x-3">
            <div className="w-8 h-8 rounded-lg bg-blue-600 flex items-center justify-center text-white font-bold">
              <Shield size={18} />
            </div>
            <div>
              <span className="text-lg font-black uppercase text-white">VIGIA <span className="text-blue-500">AUTO</span></span>
              <p className="text-[11px] text-slate-400 font-medium">Seu veículo. Seu controle.</p>
            </div>
          </div>

          <div className="flex items-center gap-3">
            <button 
              onClick={() => setIsChatOpen(true)}
              className="border border-cyan-500/30 hover:bg-cyan-600/10 text-cyan-300 px-4 py-2.5 rounded-xl font-bold transition flex items-center gap-2 uppercase tracking-wider text-xs"
            >
              <Bot size={16} className="text-cyan-400" />
              <span>DÚVIDAS COM IA</span>
            </button>
            <a 
              href={whatsappLink}
              target="_blank"
              rel="noopener noreferrer"
              className="border border-blue-500/30 hover:bg-blue-600/10 text-white px-5 py-2.5 rounded-xl font-bold transition flex items-center gap-2 uppercase tracking-wider text-xs"
            >
              <Smartphone size={16} className="text-blue-400" />
              <span>FALAR NO WHATSAPP</span>
            </a>
          </div>

        </div>
      </footer>

    </div>
  );
};

const FaqItem = ({ question, answer, isOpen, onClick }) => (
  <div className="border border-slate-900 rounded-2xl overflow-hidden bg-[#02040b] transition">
    <button 
      className="w-full flex justify-between items-center p-5 text-left font-bold text-white hover:bg-slate-900/40 transition text-sm uppercase tracking-wide"
      onClick={onClick}
    >
      <span>{question}</span>
      <ChevronDown size={18} className={`text-blue-400 transition-transform ${isOpen ? 'rotate-180' : ''}`} />
    </button>
    {isOpen && (
      <div className="p-5 bg-[#010205] text-slate-300 text-xs border-t border-slate-900 leading-relaxed font-normal">
        {answer}
      </div>
    )}
  </div>
);

export default App;
