        // Gemini API Calls
        async function callGemini(payload) {
            const apiKey = "";
            const apiUrl = `https://generativelanguage.googleapis.com/v1beta/models/gemini-3-flash-preview:generateContent?key=${apiKey}`;
            const res = await fetch(apiUrl, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });
            if (!res.ok) throw new Error('API Error');
            return await res.json();
        }

        async function handleAnalyzeRisk(e) {
            e.preventDefault();
            const input = document.getElementById('vehicle-input').value.trim();
            if (!input) return;

            const submitBtn = document.getElementById('ai-submit-btn');
            submitBtn.innerHTML = '<i class="fa-solid fa-spinner animate-spin"></i><span>Analisando...</span>';
            submitBtn.disabled = true;

            const systemPrompt = `Você é um perito em estatísticas de segurança veicular no Brasil para a Vigia Auto.
Analise o veículo informado e retorne estritamente um JSON:
{
  "vehicleName": "Nome formatado",
  "riskLevel": "Alto" | "Médio" | "Baixo",
  "riskScore": número 1-10,
  "vulnerability": "Frase curta sobre furto/roubo",
  "highlights": ["benefício 1", "benefício 2", "benefício 3"]
}`;

            try {
                const payload = {
                    contents: [{ parts: [{ text: `Analise o veículo: "${input}"` }] }],
                    systemInstruction: { parts: [{ text: systemPrompt }] },
                    generationConfig: { responseMimeType: "application/json" }
                };

                const data = await callGemini(payload);
                const jsonText = data.candidates?.[0]?.content?.parts?.[0]?.text;
                const result = JSON.parse(jsonText);

                document.getElementById('res-vehicle-name').innerText = result.vehicleName;
                document.getElementById('res-vulnerability').innerText = result.vulnerability;
                document.getElementById('res-risk-text').innerText = `${result.riskLevel} (${result.riskScore}/10)`;

                const badge = document.getElementById('res-risk-badge');
                if (result.riskLevel === 'Alto') {
                    badge.className = "px-3 py-1 rounded-full text-xs font-black uppercase tracking-wider flex items-center gap-1.5 bg-rose-500/20 text-rose-400 border border-rose-500/40";
                } else if (result.riskLevel === 'Médio') {
                    badge.className = "px-3 py-1 rounded-full text-xs font-black uppercase tracking-wider flex items-center gap-1.5 bg-amber-500/20 text-amber-300 border border-amber-500/40";
                } else {
                    badge.className = "px-3 py-1 rounded-full text-xs font-black uppercase tracking-wider flex items-center gap-1.5 bg-emerald-500/20 text-emerald-400 border border-emerald-500/40";
                }

                const list = document.getElementById('res-highlights-list');
                list.innerHTML = '';
                result.highlights.forEach(h => {
                    list.innerHTML += `<li class="flex items-start gap-2.5 text-xs text-slate-300"><i class="fa-solid fa-circle-check text-cyan-400 shrink-0 mt-0.5"></i><span>${h}</span></li>`;
                });

                document.getElementById('res-whatsapp-btn').href = `https://wa.me/5513999999999?text=Fiz%20a%20an%C3%A1lise%20do%20meu%20${encodeURIComponent(result.vehicleName)}%20e%20quero%20agendar!`;
                document.getElementById('ai-result-card').classList.remove('hidden');
            } catch (err) {
                showToast("Erro ao analisar. Tente novamente.");
            } finally {
                submitBtn.innerHTML = '<i class="fa-solid fa-wand-magic-sparkles"></i><span>Gerar Diagnóstico IA</span>';
                submitBtn.disabled = false;
            }
        }

        async function sendChatMessage(customText) {
            const inputEl = document.getElementById('chat-input');
            const msg = customText || inputEl.value.trim();
            if (!msg) return;

            const container = document.getElementById('chat-messages');
            container.innerHTML += `<div class="flex justify-end"><div class="max-w-[82%] p-3 rounded-2xl bg-blue-600 text-white rounded-br-none">${msg}</div></div>`;
            if (!customText) inputEl.value = '';
            container.scrollTop = container.scrollHeight;

            const systemPrompt = `Você é o VigiaBot, assistente virtual da Vigia Auto.
Sua missão é responder sobre rastreamento veicular 24h, bloqueio remoto, taxa de instalação (R$ 149,90) e mensalidade (R$ 39,90/mês). Responda curto em português (max 3 frases) e incentive o WhatsApp.`;

            try {
                const payload = {
                    contents: [{ parts: [{ text: msg }] }],
                    systemInstruction: { parts: [{ text: systemPrompt }] }
                };

                const data = await callGemini(payload);
                const reply = data.candidates?.[0]?.content?.parts?.[0]?.text || "Fale direto com a nossa equipe no WhatsApp!";
                container.innerHTML += `<div class="flex justify-start"><div class="max-w-[82%] p-3 rounded-2xl bg-[#040817] border border-slate-800 text-slate-200 rounded-bl-none">${reply}</div></div>`;
            } catch (err) {
                container.innerHTML += `<div class="flex justify-start"><div class="max-w-[82%] p-3 rounded-2xl bg-[#040817] border border-slate-800 text-slate-200 rounded-bl-none">Estou temporariamente indisponível. Fale conosco no WhatsApp!</div></div>`;
            }
            container.scrollTop = container.scrollHeight;
        }
    </script>
</body>
